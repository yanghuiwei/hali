diff --git a/src/gm/providers/mock_provider.gd b/src/gm/providers/mock_provider.gd
new file mode 100644
index 0000000..1c2579d
--- /dev/null
+++ b/src/gm/providers/mock_provider.gd
@@ -0,0 +1,20 @@
+class_name MockLlmProvider
+extends LlmProvider
+
+var queue: Array[String] = []
+var errors: Array[String] = []
+var requests: Array = []
+
+func complete(request: LlmProvider.LlmRequest) -> LlmProvider.LlmResponse:
+	requests.append(request)
+	var index := requests.size() - 1
+	var r := LlmProvider.LlmResponse.new()
+	if index < errors.size() and not str(errors[index]).is_empty():
+		r.error = str(errors[index])
+		return r
+	if index < queue.size():
+		r.ok = true
+		r.text = str(queue[index])
+		return r
+	r.error = "mock 队列为空"
+	return r
