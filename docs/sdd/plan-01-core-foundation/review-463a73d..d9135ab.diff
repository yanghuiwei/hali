+			"学院", "学业", "学院杯", "魁地奇", "禁林状况", "祖宅", "继承"]:
+		a.is_true(power.contains(str(label)), "第六十五章含 %s" % str(label))
+
+	# ---- 状态行与事件块 ----
+	a.is_true(PanelFormatter.status_line(w).contains("1991年9月"), "状态行含时间")
+	var events := [{"kind": "rumor", "category": "经济", "text": "魔药材料涨价了", "major": false}]
